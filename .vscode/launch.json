{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 mock server（独立演示面板）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["mock"],
      "preLaunchTask": "build",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "listening on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
