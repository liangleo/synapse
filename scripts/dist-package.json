{
  "name": "dsh-panel-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh 插件：把 session/agent 事件桥接为面板 SSE 事件，并把面板指令转换为 Agent API 调用",
  "main": "dsh-panel-bridge.js",
  "exports": {
    ".": "./dsh-panel-bridge.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dsh-panel-bridge.js",
    "panel-event.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "static/"
  ],
  "//peerDependencies": "运行在 dsh 宿主内时由宿主提供以下模块；这里声明版本用于类型检查与文档",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
